# Copia este archivo a .env.local y pega la configuración de tu app web de Firebase.
# No subas .env ni .env.local al repositorio: las reglas de Firestore protegen los datos,
# pero igual no queremos claves reales en git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional. Si escribes un correo, la app cierra la sesión de cualquier otra cuenta.
# Ejemplo: miguel@gmail.com
# La seguridad de verdad está en firestore.rules (solo el dueño autenticado lee su documento).
VITE_ALLOWED_EMAIL=
