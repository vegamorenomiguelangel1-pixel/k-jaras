rules_version = '2';
// La venta es una sola, compartida por el equipo.
// Solo entra quien tiene sesión y un documento en miembros.
// El administrador es la persona apuntada por sistema/admin.
// El primer alta puede crear ese documento mientras no exista.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminPath() {
      return /databases/$(database)/documents/sistema/admin;
    }

    function memberPath() {
      return /databases/$(database)/documents/miembros/$(request.auth.uid);
    }

    function adminExists() {
      return exists(adminPath());
    }

    function adminUid() {
      return get(adminPath()).data.uid;
    }

    function memberExists() {
      return signedIn() && exists(memberPath());
    }

    function memberRole() {
      return get(memberPath()).data.role;
    }

    function esAdmin() {
      return signedIn()
        && adminExists()
        && adminUid() == request.auth.uid
        && memberExists()
        && memberRole() == 'admin';
    }

    function esMiembro() {
      return signedIn()
        && adminExists()
        && memberExists()
        && (memberRole() == 'miembro' || adminUid() == request.auth.uid);
    }

    function nombreValido(nombre) {
      return nombre is string && nombre.size() > 0 && nombre.size() <= 80;
    }

    function slugValido(slug) {
      return slug is string
        && slug.size() > 0
        && slug.size() <= 48
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function fichaMiembro() {
      return request.resource.data.keys().hasOnly(['nombre', 'role', 'slug'])
        && nombreValido(request.resource.data.nombre)
        && slugValido(request.resource.data.slug);
    }

    function datosValidos() {
      let datos = request.resource.data;
      return datos.version == 1
        && datos.settings is map
        && datos.settings.pricePerPlate is number
        && datos.settings.pricePerPlate >= 0
        && datos.settings.pricePerPlate <= 1000000
        && datos.settings.plannedPlates is number
        && datos.settings.plannedPlates >= 1
        && datos.settings.plannedPlates <= 100000
        && datos.settings.saleDate is string
        && datos.settings.saleDate.size() > 0
        && datos.settings.saleDate.size() <= 40
        && datos.shoppingItems is list
        && datos.shoppingItems.size() <= 400
        && datos.expenses is list
        && datos.expenses.size() <= 2000
        && datos.orders is list
        && datos.orders.size() <= 5000
        && datos.clientUpdatedAt is number
        && datos.updatedAt is timestamp;
    }

    match /sistema/admin {
      allow get: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nombre'])
        && request.resource.data.uid == request.auth.uid
        && nombreValido(request.resource.data.nombre)
        && !exists(adminPath());
      allow update, delete: if false;
    }

    match /acceso/{slug} {
      allow get: if slugValido(slug);
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['local'])
        && slugValido(request.resource.data.local);
      allow delete: if esAdmin();
    }

    match /miembros/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || esAdmin());
      allow list: if esAdmin();

      allow create: if fichaMiembro() && (
        (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'admin'
          && !exists(adminPath())
        )
        || (
          esAdmin()
          && request.resource.data.role == 'miembro'
          && request.auth.uid != userId
        )
      );

      allow delete: if esAdmin() && userId != request.auth.uid;
      allow update: if false;
    }

    match /ventas/principal {
      allow read: if esMiembro();
      allow create, update: if esMiembro() && datosValidos();
      allow delete: if false;
    }

    // Documento viejo, por persona. Solo se lee para copiarlo a la venta compartida.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
